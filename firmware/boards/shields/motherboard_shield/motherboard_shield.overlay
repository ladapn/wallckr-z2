/*
 * wallckr-z2 motherboard, plugged into the Nucleo's Morpho headers
 * (J11 = CN7 = ST_MORPHO_L_*, J12 = CN10 = ST_MORPHO_R_*).
 *
 * Pin mapping follows kicad/motherboard (pad nets of J11/J12). Note that
 * sensors 1, 3 and 4 have TRIG/ECHO swapped compared with the pin table in
 * docs/DESIGN_NOTES.md; the KiCad design is taken as authoritative here.
 */

#include <zephyr/dt-bindings/gpio/st-morpho-header.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	/* Pololu DRV8874 carrier (J6/J9), PH/EN mode. */
	motor: motor {
		compatible = "wallckr,ph-en-motor";
		/* 25 kHz: above the audible range, well within DRV8874 limits. */
		pwms = <&motor_pwm 1 PWM_USEC(40) PWM_POLARITY_NORMAL>;
		ph-gpios = <&st_morpho_header ST_MORPHO_R_3 GPIO_ACTIVE_HIGH>; /* PB8 */
		fault-gpios = <&st_morpho_header ST_MORPHO_R_5 GPIO_ACTIVE_LOW>; /* PB9, R4 pull-up */
	};

	/* Hitec HS-422 on J7. Pulse range matches the Arduino Servo library
	 * defaults v1 used, so v1's angle calibration carries over.
	 */
	steering_servo: steering_servo {
		compatible = "pwm-servo";
		pwms = <&servo_pwm 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		min-pulse = <PWM_USEC(544)>;
		max-pulse = <PWM_USEC(2400)>;
	};

	/* HY-SRF05 sensors on J2..J5 (HC-SR04 compatible pinout/timing).
	 * ECHO is pulled down so an unplugged sensor reads as "no echo".
	 */
	ultrasonic1: ultrasonic1 {
		compatible = "hc-sr04";
		trigger-gpios = <&st_morpho_header ST_MORPHO_L_2 GPIO_ACTIVE_HIGH>; /* PC11 */
		echo-gpios = <&st_morpho_header ST_MORPHO_L_1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* PC10 */
	};

	ultrasonic2: ultrasonic2 {
		compatible = "hc-sr04";
		trigger-gpios = <&st_morpho_header ST_MORPHO_L_34 GPIO_ACTIVE_HIGH>; /* PB0 */
		echo-gpios = <&st_morpho_header ST_MORPHO_L_32 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* PA4 */
	};

	ultrasonic3: ultrasonic3 {
		compatible = "hc-sr04";
		trigger-gpios = <&st_morpho_header ST_MORPHO_L_37 GPIO_ACTIVE_HIGH>; /* PC3 */
		echo-gpios = <&st_morpho_header ST_MORPHO_L_35 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* PC2 */
	};

	/* PA12/PA11 double as USART6 RX/TX if sensor 4 is ever given up. */
	ultrasonic4: ultrasonic4 {
		compatible = "hc-sr04";
		trigger-gpios = <&st_morpho_header ST_MORPHO_R_12 GPIO_ACTIVE_HIGH>; /* PA12 */
		echo-gpios = <&st_morpho_header ST_MORPHO_R_14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* PA11 */
	};

	/* R1 = 300k, R2 = 75k (1/5), as fitted on the board. The schematic
	 * still says R1 = 360k, which is a schematic error.
	 */
	battery_voltage: battery_voltage {
		compatible = "voltage-divider";
		io-channels = <&adc1 9>;
		output-ohms = <75000>;
		full-ohms = <(300000 + 75000)>;
	};

	/* INA169 (1 mA/V) across Rsense1 = 100 mOhm, load R3 = 16k5:
	 * gain = 1 mA/V * 16.5 kOhm = 33 / 2.
	 */
	supply_current: supply_current {
		compatible = "current-sense-amplifier";
		io-channels = <&adc1 15>;
		sense-resistor-milli-ohms = <100>;
		sense-gain-mult = <33>;
		sense-gain-div = <2>;
	};

	/* The board's PWM LED sits on TIM2 CH1, which now drives motor EN. */
	aliases {
		/delete-property/ pwm-led0;
	};
};

/delete-node/ &green_pwm_led;

/* EN on PA15. TIM2 is 32 bit, so no prescaler is needed. */
&timers2 {
	status = "okay";

	motor_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa15>;
		pinctrl-names = "default";
	};
};

/* Servo on PB4. 84 MHz / (83 + 1) = 1 MHz, so a 20 ms period fits in 16 bit. */
&timers3 {
	status = "okay";
	st,prescaler = <83>;

	servo_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pb4>;
		pinctrl-names = "default";
	};
};

/* Hall-probe quadrature encoder on J10 (PB6 / PB7). */
&timers4 {
	status = "okay";

	encoder: qdec {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pb6 &tim4_ch2_pb7>;
		pinctrl-names = "default";
		st,input-filter-level = <15>;
		/* Placeholder until the custom encoder is characterised on the
		 * real motor; only raw counts are used for now.
		 */
		st,counts-per-revolution = <4>;
	};
};

/* Battery voltage on PB1 (IN9), supply current on PC5 (IN15). The board
 * default routes IN0/PA0 instead, which is the BLE shield's IRQ line.
 */
&adc1 {
	pinctrl-0 = <&adc1_in9_pb1 &adc1_in15_pc5>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@9 {
		reg = <9>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
		zephyr,resolution = <12>;
	};

	channel@f {
		reg = <15>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
		zephyr,resolution = <12>;
	};
};

/* Board defaults that claim motherboard pins: USART1 on PB6/PB7 (encoder),
 * I2C1 on PB8/PB9 (motor PH/FLT).
 */
&usart1 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};
